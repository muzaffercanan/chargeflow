# Copy this file to .env and replace the password before using it outside local development.
# The placeholder password lets the documented local Compose command run without a committed secret.
POSTGRES_DB=chargesquare
POSTGRES_USER=chargesquare
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_INTERNAL_PORT=5432
POSTGRES_PORT=5432

STATION_DB_SCHEMA=station
SESSION_DB_SCHEMA=session
STATION_SERVICE_PORT=8081
SESSION_SERVICE_PORT=8082
STATION_SERVICE_URL=http://station-service:8081
STATION_CONNECT_TIMEOUT=2s
STATION_READ_TIMEOUT=3s

# Local case-study values only. Replace the signing secret outside local development.
JWT_SIGNING_SECRET=replace-with-local-jwt-signing-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_SERVICE_TTL=60s
JWT_ISSUER=chargesquare-session-service
JWT_AUDIENCE=chargesquare-api
PANEL_ALLOWED_ORIGIN=http://localhost:5173
PANEL_PORT=5173
